@let(pageTitle = product ? 'Editar Produto' : 'Criar Novo Produto')

@layout.app({ title: pageTitle })
  @slot('main')
    <div class="mx-auto max-w-3xl py-6">
      <div class="bg-zinc-900/90 shadow-2xl rounded-2xl p-8 border border-zinc-800 backdrop-blur-md">

        <h1 class="text-3xl font-extrabold text-center mb-8 uppercase font-['New_Rocker'] text-red-500 tracking-wider">
          {{ pageTitle }}
        </h1>

        @let(url = product ? route('products.update', { id: product.id }, { qs: { _method: 'PUT' } }) : route('products.store'))

        @form({ action: url, method: 'POST', enctype: 'multipart/form-data' })
          <div class="space-y-6">

            <div>
              <label for="name" class="block text-xs font-bold uppercase tracking-wider text-zinc-300">Nome do Produto</label>
              <div class="mt-2">
                @!input({
                  type: 'text',
                  name: 'name',
                  id: 'name',
                  placeholder: 'Ex: Guitarra Flying V',
                  value: old('name', product?.name || ''),
                  class: 'input-rock w-full bg-zinc-950 border-zinc-800'
                })
                @!component('components/layout/partials/input_error', { field: 'name' })
              </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <label for="price" class="block text-xs font-bold uppercase tracking-wider text-zinc-300">Preço (R$)</label>
                <div class="mt-2">
                  @!input({
                    type: 'number',
                    name: 'price',
                    id: 'price',
                    placeholder: '666.00',
                    value: old('price', product?.price || ''),
                    step: '0.01',
                    class: 'input-rock w-full bg-zinc-950 border-zinc-800'
                  })
                  @!component('components/layout/partials/input_error', { field: 'price' })
                </div>
              </div>

              <div>
                <label for="quantity" class="block text-xs font-bold uppercase tracking-wider text-zinc-300">Estoque Inicial</label>
                <div class="mt-2">
                  @!input({
                    type: 'number',
                    name: 'quantity',
                    id: 'quantity',
                    placeholder: '0',
                    value: old('quantity', product?.quantity ?? 0),
                    min: '0',
                    class: 'input-rock w-full bg-zinc-950 border-zinc-800'
                  })
                  @!component('components/layout/partials/input_error', { field: 'quantity' })
                </div>
              </div>
            </div>

            <div>
              <label for="description" class="block text-xs font-bold uppercase tracking-wider text-zinc-300">Descrição</label>
              <div class="mt-2">
                <textarea
                  name="description"
                  id="description"
                  rows="6"
                  placeholder="Descreva este item brutal..."
                  class="input-rock w-full bg-zinc-950 border-zinc-800 resize-none text-sm"
                >{{ old('description', product?.description || '') }}</textarea>

                @!component('components/layout/partials/input_error', { field: 'description' })
              </div>
            </div>

            <div>
              <label for="image" class="block text-xs font-bold uppercase tracking-wider text-zinc-300">Imagem do Produto</label>
              <p class="text-xs text-zinc-500 mt-1 mb-2">
                @if(product)
                  Deixe em branco para manter a imagem atual.
                @else
                  A imagem é obrigatória para o cadastro.
                @end
              </p>
              <div class="mt-2">
                <input
                  type="file"
                  name="image"
                  id="image"
                  class="input-rock w-full bg-zinc-950 border-zinc-800 text-sm file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-xs file:font-bold file:bg-red-600 file:text-white hover:file:bg-red-700 transition-all cursor-pointer"
                  accept="image/png, image/jpeg, image/webp, image/gif"
                />
                @!component('components/layout/partials/input_error', { field: 'image' })
              </div>
            </div>

          </div>

          <div class="mt-10 flex items-center justify-end gap-x-4 border-t border-zinc-800 pt-6">
            <a href="{{ route('products.index') }}" class="btn-secondary-rock text-xs py-2.5 px-5">
              Cancelar
            </a>
            <button type="submit" class="btn-rock text-xs py-2.5 px-6">
              {{ product ? 'Salvar Alterações' : 'Criar Produto' }}
            </button>
          </div>
        @end
      </div>
    </div>
  @end
@end