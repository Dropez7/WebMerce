          <a href="{{ route('products.show', { id: product.id }) }}" class="flex-1 flex flex-col">
            <div class="aspect-square w-full overflow-hidden bg-zinc-950 group-hover:opacity-90 transition-opacity h-64 relative">
              @let(firstImage = product.images?.[0])
              @if(firstImage)
                <img src="{{ route('images.show', { name: firstImage.name }) }}" alt="{{ product.name }}" class="h-full w-full object-cover object-center transition-transform duration-500 group-hover:scale-105">
              @else
                <div class="h-full w-full flex items-center justify-center bg-zinc-900 text-zinc-700">
