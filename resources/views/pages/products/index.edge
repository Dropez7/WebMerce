                <p class="text-lg font-black text-zinc-100">
                  R$ {{ Number(product.price).toFixed(2).replace('.', ',') }}
                </p>
                <span class="text-xs font-bold px-2.5 py-0.5 rounded-full border {{ product.quantity > 0 ? 'bg-emerald-950/40 text-emerald-400 border-emerald-800/40' : 'bg-rose-950/40 text-rose-400 border-rose-800/40' }}">
                  {{ product.quantity }} em estoque
                </span>
              </div>
            </div>
          </a>

          @if(auth.user && auth.user.isAdmin())
            <div class="absolute top-3 right-3 flex flex-col gap-2 opacity-0 group-hover:opacity-100 transition-opacity">
              <a href="{{ route('products.edit', { id: product.id }) }}" title="Editar" class="text-xs bg-zinc-900/90 text-zinc-200 p-2 rounded-xl hover:bg-zinc-800 hover:text-white transition-colors border border-zinc-700 shadow-xl backdrop-blur-md">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4"><path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0 1 15.75 21H5.25A2.25 2.25 0 0 1 3 18.75V8.25A2.25 2.25 0 0 1 5.25 6H10" /></svg>
              </a>
              @form({ action: route('products.destroy', { id: product.id }, { qs: { _method: 'DELETE' }}) })
                <button type="submit" title="Deletar" class="text-xs bg-rose-950/90 text-rose-300 p-2 rounded-xl hover:bg-rose-900 hover:text-white transition-colors border border-rose-800 shadow-xl backdrop-blur-md">
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4"><path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" /></svg>
                </button>
              @end
            </div>
          @end
        </div>
      @end
    </div>
    
    @let(meta = products.meta ?? {})
    @let(current = meta.current_page ?? meta.currentPage ?? meta.page ?? meta.current ?? 1)
    @let(last = meta.last_page ?? meta.lastPage ?? meta.last ?? 1)
    @let(baseUrl = route('products.index'))
    @let(queryString = search ? `?search=${encodeURIComponent(search)}` : '')
    @let(pageSep = queryString ? '&' : '?')

    @if(last > 1)
      <div class="mt-12 flex justify-center">
        <nav class="inline-flex -space-x-px rounded-xl border border-zinc-800 bg-zinc-900 shadow-md" aria-label="Pagination">
          @if(current > 1)
            <a href="{{ baseUrl }}{{ queryString }}{{ pageSep }}page={{ current - 1 }}" class="inline-flex items-center px-4 py-2 rounded-l-xl text-xs font-bold text-zinc-300 hover:bg-zinc-800 hover:text-white transition-colors">Anterior</a>
          @else
            <span class="inline-flex items-center px-4 py-2 rounded-l-xl text-xs font-bold text-zinc-600">Anterior</span>
          @end

          <span class="inline-flex items-center px-4 py-2 border-x border-zinc-800 text-xs font-bold text-zinc-400">{{ current }} / {{ last }}</span>

          @if(current < last)
            <a href="{{ baseUrl }}{{ queryString }}{{ pageSep }}page={{ current + 1 }}" class="inline-flex items-center px-4 py-2 rounded-r-xl text-xs font-bold text-zinc-300 hover:bg-zinc-800 hover:text-white transition-colors">Próxima</a>
          @else
            <span class="inline-flex items-center px-4 py-2 rounded-r-xl text-xs font-bold text-zinc-600">Próxima</span>
          @end
        </nav>
      </div>
    @end
  @end
