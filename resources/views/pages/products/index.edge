  @if(productList.length === 0)
    <div class="text-center py-16 bg-zinc-900/40 rounded-2xl border border-zinc-800">
      <p class="text-zinc-400 font-medium">Sem produtos na área... Cadastre algo brutal!</p>
    </div>
  @else
    <div class="grid grid-cols-1 gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 xl:gap-x-8">
      @each(product in productList)
