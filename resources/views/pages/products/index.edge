@layout.app({ title: 'Produtos' })

@slot('main')
  @let(productList = products.data ?? products)

  <a href="#product-search-input" class="absolute -left-[9999px] focus:left-4 focus:top-4 focus:relative focus:inline-block focus:shadow-lg focus:bg-zinc-800 focus:text-white rounded px-3 py-2 mb-4">Pular para buscador</a>

