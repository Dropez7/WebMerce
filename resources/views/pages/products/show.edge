  <script>
    async function loadRatings() {
      const list = document.getElementById('rating-list')

      try {
        const response = await fetch("{{ route('products.ratings', { id: product.id }) }}")
        if (!response.ok) {
          throw new Error(`Falha ao carregar avaliações: ${response.status}`)
        }

        const data = await response.json()
        const avg = Number(data.average || 0)
        document.getElementById('rating-average').textContent = avg.toFixed(1)
        document.getElementById('rating-count').textContent = `(${data.ratings.length} avaliações)`

        const starsContainer = document.getElementById('rating-stars')
        starsContainer.innerHTML = ''
        const full = Math.floor(avg)
        const half = avg - full >= 0.5

        for (let i = 1; i <= 5; i++) {
          const star = document.createElement('span')
          if (i <= full) {
            star.textContent = '★'
            star.className = 'text-yellow-400'
          } else if (i === full + 1 && half) {
            star.textContent = '★'
            star.className = 'text-yellow-400'
          } else {
            star.textContent = '☆'
            star.className = 'text-zinc-600'
          }
          starsContainer.appendChild(star)
        }

        if (!data.ratings.length) {
          list.innerHTML = '<li class="text-sm text-zinc-500">Ainda não há avaliações para este item. Seja o primeiro a avaliar!</li>'
          return
        }

        list.replaceChildren(...data.ratings.map((rating) => {
          const item = document.createElement('li')
          item.className = 'rounded-xl border border-zinc-800 bg-zinc-900/60 p-4 shadow-sm'

          const header = document.createElement('div')
          header.className = 'flex items-center justify-between gap-4'

          const stars = document.createElement('span')
          stars.className = 'font-semibold text-yellow-400 tracking-wider text-sm'
          stars.textContent = `${'★'.repeat(rating.score)}${'☆'.repeat(5 - rating.score)}`

          const author = document.createElement('span')
          author.className = 'text-xs text-zinc-500 font-medium'
          author.textContent = rating.user?.fullName || 'Headbanger'

          header.append(stars, author)
          item.append(header)

          if (rating.comment) {
            const comment = document.createElement('p')
            comment.className = 'mt-2 text-sm text-zinc-300 leading-relaxed'
            comment.textContent = rating.comment
            item.append(comment)
          }

          return item
        }))
      } catch (error) {
        list.innerHTML = '<li class="text-sm text-rose-400">Não foi possível carregar as avaliações.</li>'
        console.error(error)
      }
    }

    function initStarPicker() {
      const picker = document.getElementById('star-picker')
      const hidden = document.getElementById('score-input')
      if (!picker || !hidden) return

      const stars = picker.querySelectorAll('.star')
      let selectedRating = Number(hidden.value) || 5

      const paintStars = (val) => {
        stars.forEach((st) => {
          const v = Number(st.getAttribute('data-value'))
          if (v <= val) {
            st.classList.remove('text-zinc-700', 'text-zinc-600', 'text-zinc-500')
            st.classList.add('text-yellow-400')
          } else {
            st.classList.remove('text-yellow-400')
            st.classList.add('text-zinc-700')
          }
        })
      }

      stars.forEach((st) => {
        const val = Number(st.getAttribute('data-value'))

        st.addEventListener('mouseover', () => {
          paintStars(val)
        })

        st.addEventListener('click', (e) => {
          e.preventDefault()
          selectedRating = val
          hidden.value = val
          paintStars(selectedRating)
        })
      })

      picker.addEventListener('mouseleave', () => {
        paintStars(selectedRating)
      })

      paintStars(selectedRating)
    }

    loadRatings()
    initStarPicker()
  </script>
@end
@end